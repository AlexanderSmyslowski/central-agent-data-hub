DATABASE_URL=postgresql://postgres:changeme@localhost:55432/agent_hub
OBSIDIAN_EXPORT_DIR=.local/obsidian-export
AGENT_HUB_BACKUP_DIR=.local/backups

# Backups older than this are treated as stale by scripts/db_backup_health.sh.
AGENT_HUB_BACKUP_MAX_AGE_HOURS=36

# Set a strong password for the local Postgres instance.
# The docker-compose default is 'changeme' for disposable local setups only.
POSTGRES_PASSWORD=changeme

# AGENT_HUB_BACKUP_REMOTE=user@example.com:/path/to/agent-hub-backups/
