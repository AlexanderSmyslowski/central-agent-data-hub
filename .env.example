# Applies to the durable local ops path. The public demo path intentionally
# ignores this value and forces its own demo database.
DATABASE_URL=postgresql://postgres:changeme@127.0.0.1:55432/agent_hub
# Optional on macOS: pin durable operations to a Homebrew PostgreSQL service.
# AGENT_HUB_NATIVE_POSTGRES_SERVICE=postgresql@16
OBSIDIAN_EXPORT_DIR=.local/obsidian-export
AGENT_HUB_BACKUP_DIR=.local/backups

# Backups older than this are treated as stale by scripts/db_backup_health.sh.
AGENT_HUB_BACKUP_MAX_AGE_HOURS=36

# Set a strong password for the local Postgres instance.
# The docker-compose default is 'changeme' for disposable local setups only.
POSTGRES_PASSWORD=changeme

# Optional internal reviewer attribution. This is not authentication.
# If AGENT_HUB_REVIEWERS is set, only listed handles are accepted.
# AGENT_HUB_REVIEWERS=alice,bob
# AGENT_HUB_REVIEWER=alice
# AGENT_HUB_DEFAULT_REVIEWER=alice
# HUB_VIEW_REVIEWER=alice

# AGENT_HUB_BACKUP_REMOTE=user@example.com:/path/to/agent-hub-backups/
